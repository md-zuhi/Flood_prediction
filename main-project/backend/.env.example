PORT=5000
ML_API_URL=http://127.0.0.1:8000/predict

# NASA Earthdata Access Token
EARTHDATA_TOKEN=

# OpenTopography API Key
OPENTOPOGRAPHY_API_KEY=

# Mappls Developer Credentials (India-focused Traffic & Routing)
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# OpenRouteService API Key (Optional Hazard Avoidance)
OPENROUTESERVICE_API_KEY=

# TomTom Traffic API Key (Optional Traffic Incidents)
TOMTOM_API_KEY=

# SMS Alert Provider Configuration (mock | twilio | fast2sms)
SMS_PROVIDER=mock

# Twilio Credentials (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# Hackathon Demo / Test Controls
DEMO_ALERT_MODE=false
DEMO_TEST_PHONE=
ALERT_COOLDOWN_MINUTES=30

